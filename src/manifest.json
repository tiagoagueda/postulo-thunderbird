{
  "manifest_version": 3,
  "name": "Postulo",
  "version": "0.3.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://source.tiagoagueda.com/postulo/postulo",
  "icons": {
    "16": "icons/postulo-16.png",
    "32": "icons/postulo-32.png",
    "48": "icons/postulo-48.png",
    "96": "icons/postulo-96.png",
    "128": "icons/postulo-128.png"
  },
  "permissions": ["messagesRead", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/postulo-16.png",
      "32": "icons/postulo-32.png"
    }
  },
  "message_display_action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/postulo-16.png",
      "32": "icons/postulo-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "postulo-thunderbird@tiagoagueda.com",
      "strict_min_version": "128.0"
    }
  }
}
